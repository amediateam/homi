{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make dev-check*)",
      "Bash(make dev-status*)",
      "Bash(make ai-skills*)",
      "Bash(make ai-hooks-test*)",
      "Bash(make registry-check*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(vendor/bin/pint*)",
      "Bash(php artisan test*)",
      "Bash(composer ci:check*)",
      "Bash(composer types:check*)",
      "Bash(pnpm -r lint*)",
      "Bash(pnpm -r typecheck*)",
      "Bash(python3 -m unittest*)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh pr merge*)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan migrate:rollback*)",
      "Bash(php artisan db:wipe*)",
      "Bash(composer require*)",
      "Bash(composer remove*)",
      "Bash(composer update*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm update*)",
      "Bash(npm install *)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(psql *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.backup*)",
      "Read(**/.env.bak)",
      "Read(**/envprod*)",
      "Read(**/key.md)",
      "Read(**/*-key.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(/.claude/skills/**)",
      "Edit(/.agents/skills/**)",
      "Edit(/.grok/skills/**)",
      "Edit(/backend/AGENTS.md)",
      "Edit(/backend/vendor/**)",
      "Edit(/backend/resources/js/actions/**)",
      "Edit(/backend/resources/js/routes/**)",
      "Edit(/backend/resources/js/wayfinder/**)",
      "Edit(/docs/backend/package-registry.md)",
      "Edit(/.ai/memory/package-capabilities.md)",
      "Edit(/frontend/**/node_modules/**)",
      "Bash(php artisan serve*)",
      "Bash(brew services start nginx*)",
      "Bash(brew services restart nginx*)",
      "Bash(brew services run nginx*)",
      "Bash(sudo brew services start nginx*)",
      "Bash(sudo brew services restart nginx*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.ai/hooks/session_context.py\"",
            "timeout": 15,
            "statusMessage": "HOMI: loading session memory"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.ai/hooks/guard_paths.py\"",
            "timeout": 10,
            "statusMessage": "HOMI: path guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.ai/hooks/format_on_edit.py\"",
            "timeout": 90,
            "statusMessage": "HOMI: formatting the edited file"
          }
        ]
      }
    ]
  }
}
