# frontend/app — copy to .env.local (gitignored). Only NEXT_PUBLIC_* values are shipped to the browser.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL=https://api.homi.loc/api/v1
NEXT_PUBLIC_CDN_URL=https://cdn.homi.loc
# The bot's username without "@", read by lib/brand (WP-20); empty hides every bot link in the app.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# PostHog (WP-32, DEC-47): HOMI's own project, one per environment (staging, production); never the legacy project.
# Without the key or the host no PostHog code is loaded. CSP_ANALYTICS_HOSTS must name the same host.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# The build of the app, set by the deploy (at most 40 characters; `dev` when unset): `v` of the journal, `build` in PostHog.
# NEXT_PUBLIC_BUILD_VERSION=
# Server-only (WP-21): never shipped to the browser.
# The API base for the app server's own calls (/bff/session); empty falls back to NEXT_PUBLIC_API_URL.
API_URL=
# CSP host lists, https origins separated by spaces or commas; a non-https value stops the app at start.
# Frames allowed to show the app (Telegram Web); empty means https://web.telegram.org. Never 'none'.
CSP_FRAME_ANCESTORS=
# Map tile origins (WP-27), used by two policies: the page's (connect-src and img-src) and the one the proxy sends
# with MapLibre's worker under /maplibre/ (connect-src), because the worker fetches the tiles of a tile template
# itself and a same-origin worker does not inherit the page's policy. The OpenStreetMap raster fallback (reference data
# with no tiles_url) needs https://tile.openstreetmap.org; a hosted PMTiles file or tile template needs its own origin
# too (the PMTiles reader fetches byte ranges on the page, the worker fetches template tiles: both are connect-src).
CSP_TILE_HOSTS=
# The PostHog host of NEXT_PUBLIC_POSTHOG_HOST (connect-src only: the SDK is bundled, nothing is loaded from PostHog).
CSP_ANALYTICS_HOSTS=
# 1 sends the policy as Content-Security-Policy-Report-Only (the first staging deploy).
CSP_REPORT_ONLY=
