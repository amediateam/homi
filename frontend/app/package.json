{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node boot/build.mjs && node dev/build.mjs && node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node boot/build.mjs && node dev/build.mjs --clean && node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config ../vitest.config.mts --project app",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@homi/api-client": "workspace:*",
    "@homi/config": "workspace:*",
    "@homi/i18n": "workspace:*",
    "@homi/search": "workspace:*",
    "@homi/types": "workspace:*",
    "@homi/ui": "workspace:*",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "maplibre-gl": "6.11.2",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pmtiles": "4.5.0",
    "posthog-js": "1.434.15",
    "protomaps-leaflet": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supercluster": "8.0.1"
  },
  "devDependencies": {
    "@homi/testing": "workspace:*",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
