# Machine-specific paths and switches for repository tooling (master prompt §0.5, ADR-0001).
# Copy to .ai/local.env (gitignored) and adjust. Never commit absolute paths elsewhere.

# Root of this checkout (defaults to the directory that contains .ai/ when unset)
HOMI_ROOT=

# Read-only reference codebase (hooks block writes under this path)
APPUZ_ROOT=/path/to/Server/app.uz

# Sibling collectors / platforms (read-only references for integration work)
TELEGRAMUZ_ROOT=/path/to/Server/local/telegram.uz
DATAHUB_ROOT=/path/to/Server/local/datahub.uz
GEOUZ_ROOT=/path/to/Server/geo.uz

# Legacy kvadro² checkout (SVN working copy): read-only; builds and dev servers there reach production
KVADRO_ROOT=/path/to/Server/kvadro.uz

# Infrastructure mirrors (read-only; contain nginx configs and the CDN guide)
CDN_DOCS_PATH=/path/to/Server/nginx/31.220.104.38/docs/cdn-deploy-guide.md
NGINX_MIRROR_WEB=/path/to/Server/nginx/159.253.19.121
NGINX_MIRROR_CDN=/path/to/Server/nginx/31.220.104.38

# Local services (defaults match ADR-0008)
NGINX_ETC=/opt/homebrew/etc/nginx
HOMI_NEXT_PORT_LANDING=3000
HOMI_NEXT_PORT_APP=3001
HOMI_NEXT_PORT_ARM=3002
