# HOMI backend — environment template. Copy to .env; `scripts/dev/env-keys.sh` compares KEY names.
# Local values below match ADR-0005/0006/0008 and docs/infrastructure/environments.md.
# Real credentials live only in server-side .env files; agents read this template, never .env.

APP_NAME=HOMI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.homi.loc
APP_TIMEZONE=UTC

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 (local Homebrew service; staging/production on 5.45.127.98, ADR-0011)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=homi
DB_USERNAME=
DB_PASSWORD=

# Sessions only serve the Horizon/Telescope/Pulse dashboards; the API is token-based (ADR-0003)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Redis for queue + cache (ADR-0005); Horizon is the worker
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@homi.uz"
MAIL_FROM_NAME="${APP_NAME}"

# Media (ADR-0012): locally the `public` disk (backend/storage/app/public) is served by https://cdn.homi.loc.
# MEDIA_PUBLIC_URL is the URL base in every environment (cdn.homi.loc / cdn.staging.homi.uz / cdn.homi.uz).
MEDIA_PUBLIC_URL=https://cdn.homi.loc

# Object storage — staging/production only (MinIO via https://s3.hc.uz, per-environment IAM users, ADR-0011).
# Leave blank locally; no MinIO runs in development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=
MEDIA_PRIVATE_BUCKET=
MEDIA_TMP_BUCKET=

# Telegram — three bots exist (dev / staging / production); one token per environment, never shared
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://hook.homi.loc/telegram/webhook

# Auth / API (ADR-0003, ADR-0007)
SANCTUM_TOKEN_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=https://homi.loc,https://app.homi.loc,https://arm.homi.loc

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
