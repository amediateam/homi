# HOMI backend — environment template. Copy to .env; `scripts/dev/env-keys.sh` compares KEY names.
# Local values below match ADR-0005/0006/0008 and docs/infrastructure/environments.md.
# Real credentials live only in server-side .env files; agents read this template, never .env.

APP_NAME=HOMI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.homi.loc
APP_TIMEZONE=UTC

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 (local Homebrew service; staging/production on 5.45.127.98, ADR-0011)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=homi
DB_USERNAME=
DB_PASSWORD=

# Sessions only serve the Horizon/Telescope/Pulse dashboards; the API is token-based (ADR-0003)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Telescope records everything locally. Outside local, only with TELESCOPE_RECORD_ALL=true;
# otherwise only failures (config/telescope.php).
# On staging and production, /telescope and /horizon sit behind nginx basic auth
# (app/Http/DashboardAccess.php). Never set HOMI_DASHBOARD_USER in .env.
TELESCOPE_RECORD_ALL=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Redis for queue + cache (ADR-0005); Horizon is the worker
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@homi.uz"
MAIL_FROM_NAME="${APP_NAME}"

# Media (ADR-0012, config/media.php): one disk per role. Locally public / local / tmp (all on disk;
# backend/storage/app/public is served by https://cdn.homi.loc). Staging/production: s3_public / s3_private / s3_tmp.
# MEDIA_PUBLIC_URL is the CDN base in every environment (cdn.homi.loc / cdn.staging.homi.uz / cdn.homi.uz).
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local
MEDIA_TMP_DISK=tmp
MEDIA_PUBLIC_URL=https://cdn.homi.loc

# Object storage — staging/production only (MinIO via https://s3.hc.uz, per-environment IAM users and buckets, ADR-0011).
# Leave blank locally; no MinIO runs in development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
MEDIA_PUBLIC_BUCKET=
MEDIA_PRIVATE_BUCKET=
MEDIA_TMP_BUCKET=

# Telegram — three bots exist (dev / staging / production); one token per environment, never shared
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://hook.homi.loc/telegram/webhook
# Public name of HOMI's support account, shown by the Mini App (GET /api/v1/reference, WP-11); blank = none.
TELEGRAM_SUPPORT_USERNAME=
# How long a Mini App launch value (initData) is accepted at sign-in, in seconds (backend/config/telegram.php, WP-40,
# SEC-REQ-002); blank = 3600. The token above must be the token of this environment's own bot.
TELEGRAM_INITDATA_MAX_AGE=

# Auth / API (ADR-0003, ADR-0007). Token lifetime is set per token (`expires_at`), not globally:
# a global Sanctum expiration would also kill long-lived collector tokens (intake:token).
CORS_ALLOWED_ORIGINS=https://homi.loc,https://app.homi.loc,https://arm.homi.loc
# Prefix of every issued API token (config/sanctum.php), so a leaked one is recognisable (WP-40).
SANCTUM_TOKEN_PREFIX=homi_
# Comma-separated addresses whose X-Forwarded-For is believed (backend/config/trustedproxy.php, WP-40): the addresses
# the Next servers reach the API from, because the Mini App calls the API server-side; blank = trust nobody (locally).
TRUSTED_PROXIES=

# Access gate (backend/config/access.php, WP-40, DEC-43, DEC-60). ACCESS_MODE: private | invite | open; blank or unset
# = private (fails closed), so locally and on the servers it is set to open. ACCESS_MAX_SEATS: whole number of admitted
# users in open mode; blank = no limit, anything else that is not a whole number = 0. ACCESS_OWNER_TELEGRAM_IDS:
# comma-separated Telegram ids always let in (private mode). ACCESS_PAUSED: true answers every sign-in and bearer
# method 403 reason "paused" (team accounts pass, DEC-106); blank or unset = off.
ACCESS_MODE=open
ACCESS_MAX_SEATS=
ACCESS_OWNER_TELEGRAM_IDS=
ACCESS_PAUSED=
# Distinct full listing cards one user may open in 24 hours (backend/config/rate_limits.php, WP-40, DEC-59,
# DEC-104 … DEC-107); blank or not a positive whole number = 100.
RATE_LIMIT_LISTING_OPENS_PER_DAY=

# Source drivers of /api/v1 (ADR-0017, backend/config/sources.php, WP-10). true lets a rule or a default name the
# `stub` driver (fixtures); WP-48 turns it off on production. Drivers change with `php artisan sources:set`, not here.
SOURCES_ALLOW_STUB=true
# true answers sign-in, GET /me and settings (and, in later packages, every method a native body replaced) from the
# stub fixtures, for the end-to-end suite and the Telegram emulator (backend/config/sources.php, WP-40). Allowed only
# with APP_ENV local or testing: the API refuses to boot with it anywhere else. Staging and production leave it unset.
SOURCES_NATIVE_STUBS=true

# The legacy API behind the `legacy` source driver (backend/config/legacy.php, WP-41, DEC-33, DEC-42). Only staging and
# production set LEGACY_API_URL and LEGACY_SERVICE_KEY, once the operator has issued the key (WP-02); never locally, in
# CI or in the repository. Blank = the default: LEGACY_AUTH_HEADER X-Service-Key; LEGACY_AUTH_PREFIX none (a prefix with
# a trailing space is quoted, "Bearer "); LEGACY_LOCALE_VIA header (or query, none) with LEGACY_LOCALE_NAME
# Accept-Language; LEGACY_CURRENCY_VIA none with LEGACY_CURRENCY_NAME currency; LEGACY_RATE_PER_SECOND 5 (a whole number
# above 0). LEGACY_FAKE: true answers from the fixtures (backend/resources/fixtures/legacy) instead of the network; blank
# = on with APP_ENV local or testing, off elsewhere; the API refuses to boot with it in production. The source.* flags
# stay `stub` until WP-48: setting the key switches nothing on.
LEGACY_API_URL=
LEGACY_SERVICE_KEY=
LEGACY_AUTH_HEADER=
LEGACY_AUTH_PREFIX=
LEGACY_LOCALE_VIA=
LEGACY_LOCALE_NAME=
LEGACY_CURRENCY_VIA=
LEGACY_CURRENCY_NAME=
LEGACY_RATE_PER_SECOND=
LEGACY_FAKE=

# The listings through legacy (WP-42). LEGACY_MEDIA_PUBLIC_URL: HOMI's nginx proxy of the legacy photos on the media
# host, for example https://<media host>/lm (staging and production; blank = photo lists are empty and a warning is
# logged). LEGACY_MEDIA_HOSTS: comma-separated legacy hosts whose absolute photo addresses are rewritten too (blank =
# the host of LEGACY_API_URL). Previews of a personal list (DEC-110): LEGACY_PREVIEWS_MAX_WAIT_MS the limiter wait one
# batch may spend (blank = 4000), LEGACY_PREVIEWS_BACKGROUND_WAIT_MS the same for a background batch (blank = 2000),
# LEGACY_PREVIEWS_DEADLINE_MS the most one batch may take in all (blank = 12000, below the Mini App's 15 s timeout).
# LEGACY_CACHE_FILL_WAIT_MS: how long a request waits for another one filling the same cold cache entry (blank = 1000,
# 0 = never waits).
LEGACY_MEDIA_PUBLIC_URL=
LEGACY_MEDIA_HOSTS=
LEGACY_PREVIEWS_MAX_WAIT_MS=
LEGACY_PREVIEWS_BACKGROUND_WAIT_MS=
LEGACY_PREVIEWS_DEADLINE_MS=
LEGACY_CACHE_FILL_WAIT_MS=

# Contact and translation through legacy (WP-43; the operator's answers to WP-02 points 7 and 8 are open).
# LEGACY_CONTACT_MODE: auto (default; per card: a phone → HOMI's call page, only a call link → the operator's link),
# phone or link. LEGACY_CONTACT_LINK_HOSTS: comma-separated hosts the operator's call links may point to besides the
# host of LEGACY_API_URL, each host (port 443) or host:port (blank = only that host, on its own port).
# LEGACY_TRANSLATION_VIA: locale (default, the language selector of every call), query, body or unsupported;
# LEGACY_TRANSLATION_NAME: the parameter name for query or body (blank = lang).
LEGACY_CONTACT_MODE=
LEGACY_CONTACT_LINK_HOSTS=
LEGACY_TRANSLATION_VIA=
LEGACY_TRANSLATION_NAME=

# Author keys (backend/config/contacts.php, WP-42): the HMAC secret that turns an author's phone into the pseudonymous
# key of listing_refs. Staging and production: random, at least 32 bytes, different per environment, set before the
# card feature switches to `legacy` and never changed once keys are stored (a new secret orphans every block and vote).
# Blank or shorter = no phone key is derived (fine locally and in the tests).
AUTHOR_KEY_SECRET=

# HOMI's call page and the contact quota (backend/config/contacts.php, WP-43). CALL_LINK_SIGNING_KEY signs the call
# links: staging and production random, at least 32 bytes, different per environment (blank or shorter = no call link
# outside local and testing, which derive one from APP_KEY); to rotate, move the old value to
# CALL_LINK_SIGNING_KEY_PREVIOUS for at least eleven minutes (a link lives 600 s + 60 s), then blank it.
# CONTACT_SOFT_LIMIT / CONTACT_HARD_LIMIT: distinct listings a user gets a number for per Tashkent day / asks for
# before the account is flagged; blank = no limit (the values are a product decision, DEC-19; production starts blank).
CALL_LINK_SIGNING_KEY=
CALL_LINK_SIGNING_KEY_PREVIOUS=
CONTACT_SOFT_LIMIT=
CONTACT_HARD_LIMIT=

# Radars (backend/config/radar.php, WP-11, DEC-51): true lets users create and change radars. On locally and in the
# tests; staging and production leave it UNSET (off) until the bot can deliver them (WP-57).
# RADAR_MAX: active radars per user, blank = 10 (`GET /reference` reports it as limits.radars). RADAR_REQUIRE_CHAT:
# true refuses a radar write with 409 no_chat while the bot cannot write to the user; RADAR_STARTER_ENABLED: true lets
# a write pick the starter list of listings the bot sends. Both blank = false, locally and on the servers, until the
# bot keeps the chat state (WP-52) and sends the starter list (WP-54) — its deploy switches both to true (WP-45).
RADAR_CREATION_ENABLED=true
RADAR_MAX=
RADAR_REQUIRE_CHAT=
RADAR_STARTER_ENABLED=

# The owner cabinet (backend/config/owner.php, WP-80, DEC-81). OWNER_CABINET_ENABLED: true locally; unset on the
# servers until DEC-81's gates (blank or unset = off). OWNER_CABINET_ALLOWED_IDS: comma-separated Telegram ids allowed
# to create, request a phone and publish while it is set (WP-84); blank = no allow-list. OWNER_LISTINGS_PUBLIC: native
# listings in the feed (WP-86); blank or unset = on, only `false` turns it off.
OWNER_CABINET_ENABLED=
OWNER_CABINET_ALLOWED_IDS=
OWNER_LISTINGS_PUBLIC=

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
